  "narrative": {
    "northStar": "The recording desk",
    "overview": "Swoop uses a fixed graphite workbench for recording, framing and editing time-based media. The chrome is restrained and compact; the video carries color, motion and personality. Stable tool locations, clear time readouts and direct preview feedback matter more than decorative animation.\n\nThis document records the built interface after its bounded correction pass. The actual typeface is locally bundled Manrope Variable and the actual icon family is Lucide. The earlier Segoe/Phosphor proposal in DESIGN-DIRECTION.md remains historical direction evidence, not the current implementation specification.",
    "keyCharacteristics": [
      "One warm orange action and selection family over green-tinted graphite neutrals.",
      "A tight single-family type ramp with tabular time values.",
      "Persistent source, timeline and inspector relationships.",
      "Expressive content inside the preview; quiet, immediate editor controls."
    ],
    "rules": [
      {
        "name": "The Output Color Rule",
        "body": "Canvas backgrounds and cursor colors may be saturated. They describe the video being made; they do not introduce a competing chrome action color.",
        "section": "colors"
      },
      {
        "name": "The Readable Control Rule",
        "body": "Preserve the final 11px functional label and 10px time-ruler sizes when adding comparable controls. Remaining smaller metadata in the current status strip, trim fields and minor timeline furniture is not a size precedent for new input labels.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** keep the video larger and more expressive than the editor chrome.",
      "**Do** use the orange family for action, selection, playhead and focus state.",
      "**Do** preserve tabular numbers for duration, timing and numeric controls.",
      "**Do** update preview output immediately when a treatment changes.",
      "**Do** keep primary actions at the corrected 44px hit size.",
      "**Do** respect reduced-motion for interface transitions while keeping creative output motion an explicit setting."
    ],
    "donts": [
      "**Don't** turn the editor into a landing page with feature cards or oversized headings.",
      "**Don't** introduce a second icon family or an external font request.",
      "**Don't** copy the residual tiny metadata sizes into new functional form labels.",
      "**Don't** animate content visibility behind scroll or delay access to the editor with entrance choreography.",
      "**Don't** imply recording, saving or export success without real application state."
    ]
  }
}